<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Form for Editing blog</h1>
    <form action="/blogs/<%=foundBlog.id%>?_method=PATCH" method="POST">
        <div>
            <label for="name">Blog name: </label>
            <input type="text" name="name" id="<%=foundBlog.<%=name">
        </div>
        <div>
            <label for="content">Content: </label>
            <input type="text" name="content" id="<%=foundBlog.content">
        </div>
        <div>
            <label for="author">Author: </label>
            <input type="text" name="author" id="<%=foundBlog.author%>">
        </div>
        <button type="submit" >Edit Blog</button>
    </form>

</body>
</html>